        'Ensure-GitKeySetup'
        'Select-Location'
        'ConvertTo-DockerSafeRepoName'
        'Build-DockerRunCommand'
        'Get-ContainerGitSshCommand'
        'Get-ContainerSshSetupCommand'
        'Test-DockerDaemonReady'
        'Start-DockerDesktopIfNeeded'
        'Add-GitHubSshKey'
        'Remove-GitHubSshKey'
        'Test-GitHubUsername'
