# a non-breaking space inside
ACCEPT ADMIN_CONTACT Alice\xc2\xa0Example

REFUSE ADMIN_CONTACT

# a space only
REFUSE ADMIN_CONTACT \x20

# a non-breaking space only
REFUSE ADMIN_CONTACT \xc2\xa0

# a non-breaking space at the start
REFUSE ADMIN_CONTACT \xc2\xa0Alice

# a non-breaking space at the end
REFUSE ADMIN_CONTACT Alice\xc2\xa0

# an ideographic space at the end
REFUSE ADMIN_CONTACT Alice\xe3\x80\x80

# a zero-width space only
REFUSE ADMIN_CONTACT \xe2\x80\x8b

# a zero-width space inside
REFUSE ADMIN_CONTACT Alice\xe2\x80\x8bExample

# a right-to-left override
REFUSE ADMIN_CONTACT Alice \xe2\x80\xaeelpmaxE

# a direction isolate
REFUSE ADMIN_CONTACT Alice\xe2\x81\xa6Example

# a byte order mark inside
REFUSE ADMIN_CONTACT Alice\xef\xbb\xbfExample

# a soft hyphen
REFUSE ADMIN_CONTACT Alice\xc2\xadExample

# a tag character
REFUSE ADMIN_CONTACT Alice\xf3\xa0\x81\x81

# a tab
REFUSE ADMIN_CONTACT Ali\tce

# DEL
REFUSE ADMIN_CONTACT Alice\x7f

# a control character of the range U+0080 to U+009F
REFUSE ADMIN_CONTACT Alice\xc2\x85

# a line separator
REFUSE ADMIN_CONTACT Alice\xe2\x80\xa8Example

# no valid UTF-8
REFUSE ADMIN_CONTACT Alice\xff

# a surrogate in UTF-8 (no valid UTF-8)
REFUSE ADMIN_CONTACT Alice\xed\xa0\x80

